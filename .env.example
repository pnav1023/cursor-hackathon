GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash. Used by from-video.
# GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
# Optional. Defaults to gpt-4o. Used by map-apis.
# OPENAI_MODEL=gpt-4o

# Optional. If set, POST/GET /v1/jobs require Authorization: Bearer <key>
# COMPILE_API_KEY=
# Base URL for the compile-app-workflows Cursor skill / client script
# COMPILE_API_URL=http://127.0.0.1:8000
# Optional job storage directory. Defaults to <repo>/dist/jobs
# COMPILE_JOBS_DIR=
# PORT=8000

# Invoice Ninja (hosted default https://invoicing.co). Never commit the real token.
# INVOICE_NINJA_BASE_URL=https://invoicing.co
# INVOICE_NINJA_API_TOKEN=
# Self-hosted only:
# INVOICE_NINJA_API_SECRET=
